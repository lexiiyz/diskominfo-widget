    {
      "parameters": {
        "jsCode": "// Tangkap pesan error dari node sebelumnya (AI Agent)\n// Jika undefined, gunakan string kosong agar tidak crash\nconst rawError = $json.error?.message || $json.error || \"Unknown Error\";\nconst errorString = String(rawError).toLowerCase();\n\n// Siapkan pesan default jika error-nya aneh/tidak dikenali\nlet friendlyMessage = \"Maaf, sistem saat ini sedang mengalami gangguan teknis. Silakan coba beberapa saat lagi.\";\n\n// Deteksi spesifik: Limit Token / Quota Habis (Error 429)\nif (errorString.includes(\"429\") || errorString.includes(\"too many request\") || errorString.includes(\"quota\")) {\n    friendlyMessage = \"Maaf, sistem sedang melayani banyak permintaan (antrean penuh). Mohon tunggu sekitar 1 menit lalu coba lagi.\";\n} \n// Deteksi spesifik: Timeout / Otak AI lelet mikir\nelse if (errorString.includes(\"timeout\") || errorString.includes(\"econnreset\")) {\n    friendlyMessage = \"Maaf, koneksi otak AI kami sedang lambat. Pertanyaanmu gagal diproses karena waktu tunggu habis (Timeout).\";\n} \n// Deteksi spesifik: API Key salah / Server AI mati (Error 401 / 403)\nelse if (errorString.includes(\"401\") || errorString.includes(\"403\") || errorString.includes(\"authentication\")) {\n    friendlyMessage = \"Sistem AI sedang dalam perbaikan jaringan. (Kode: Auth Error). Hubungi administrator.\";\n}\n\n// Format output untuk dikembalikan ke Vercel (sesuaikan key \"text\" dengan frontend-mu)\nreturn {\n    text: friendlyMessage,\n    // Kita tetap kirim raw_error untuk kebutuhan debugging di console browser (optional)\n    debug_error: rawError \n};"
      },
