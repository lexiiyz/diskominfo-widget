      "name": "Extract from File1"
    },
    {
      "parameters": {
        "jsCode": "// Ambil semua item (baris excel)\nconst allRows = items;\n\n// Ubah setiap baris jadi satu string panjang\nconst textContent = allRows.map(row => {\n  const data = row.json;\n  // Teknik: Ambil Kunci (Header) dan Gabung dengan Nilai (Isi Cell)\n  return Object.keys(data)\n    .map(key => `${key}: ${data[key]}`) // Contoh -> \"First name: Agus\"\n    .join(\", \"); // Pisahkan antar kolom dengan koma\n}).join(\"\\n\"); // Pisahkan antar baris siswa dengan Enter\n\n// Return sebagai 1 item besar berisi teks\nreturn [\n  {\n    json: {\n      text: textContent\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        0
      ],
      "id": "972e5520-a9fe-4039-872d-b2c3ec800686",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        992,
        176
      ],
      "id": "fa7e7592-1bd8-4ede-8528-15bb58054777",
      "name": "Extract from File2"
    },
    {
      "parameters": {
        "jsCode": "const rawItems = $input.all();\n\n// 1. Definisikan Blacklist\nconst trashPhrases = [\n  \"halaman ini sengaja dikosongkan\",\n  \"make it empty\",\n  \"this page is intentionally left blank\",\n  \"halaman kosong\"\n];\n\nfor (const item of rawItems) {\n  // Ambil teks raksasa utuh dari PDF-nya\n  let content = item.json.pageContent || item.json.text || \"\";\n  \n  // Bedah teks menjadi baris-baris terpisah (berdasarkan enter/newline)\n  let lines = content.split('\\n');\n  \n  // Filter setiap baris\n  let cleanLines = lines.filter(line => {\n    let lineLower = line.toLowerCase();\n    \n    // Cek apakah di baris ini terdapat frasa blacklist\n    let isTrash = trashPhrases.some(phrase => lineLower.includes(phrase));\n    \n    // Kalau baris ini adalah sampah, kembalikan 'false' (buang)\n    // Kalau bersih, kembalikan 'true' (simpan)\n    return !isTrash;\n  });\n  \n  // Gabungkan kembali baris-baris yang sudah bersih menjadi satu teks utuh\n  item.json.text = cleanLines.join('\\n');\n  \n  // Timpa field pageContent (jika ada) biar tidak ada data ganda yang bikin bingung AI\n  if (item.json.pageContent) {\n      item.json.pageContent = item.json.text; \n  }\n}\n\n// Kembalikan item yang isi teksnya sudah di-\"laundry\"\nreturn rawItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        -336
      ],
      "id": "cb52de20-6d8e-478a-998c-e2f4ea3ee58c",
      "name": "Code in JavaScript1",
      "alwaysOutputData": true
    }
